<?xml version='1.0' encoding='UTF-8'?>
<ExtensionManifest ExtensionBundleId="love.svija.SvijaToolsLegacy" ExtensionBundleVersion="1.0.5" Version="8.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <ExtensionList>
    <Extension Id="love.svija.SvijaToolsLegacy.panel" Version="1.0.5" />
    <Extension Id="love.svija.SvijaLauncherLegacy.panel" Version="1.0.5" />
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <Host Name="ILST" Version="17" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="8.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    
    <Extension Id="love.svija.SvijaToolsLegacy.panel"><!-- ———————————————————— -->
      <DispatchInfo>
        <Resources>


          <MainPath>./panel/index.html</MainPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>

        </Resources>

        <Lifecycle>
          <AutoVisible>true</AutoVisible>  
          <StartOn>  
            <Event>documentAfterActivate</Event>
          </StartOn>  
        </Lifecycle>

        <UI>
          <Type>Panel</Type>
          <Menu>Svija Tools Legacy</Menu>
          <Geometry>
            <Size>
                <Width>240</Width>
                <Height>82</Height>
            </Size>
            <MinSize>
                <Width>60</Width>
                <Height>20</Height>
            </MinSize>
            <MaxSize>
                <Width>240</Width>
                <Height>671</Height>
            </MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./panel/svg/panelIcons_light.svg</Icon>
            <Icon Type="DarkNormal">./panel/svg/panelIcons_dark.svg</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>

  </DispatchInfoList>
</ExtensionManifest>
