<?xml version='1.0' encoding='UTF-8'?>
<ExtensionManifest ExtensionBundleId="love.svija.SvijaTools" ExtensionBundleVersion="1.0.0" Version="8.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <ExtensionList>
    <Extension Id="love.svija.SvijaTools.panel" Version="1.0.0" />
    <Extension Id="love.svija.SvijaLauncher.panel" Version="1.0.0" />
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <Host Name="ILST" Version="25" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="8.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    
    <Extension Id="love.svija.SvijaTools.panel"><!-- ———————————————————— -->
      <DispatchInfo>
        <Resources>
          <MainPath>./client/index.html</MainPath>
          <CEFCommandLine />
        </Resources>

        <Lifecycle>
          <AutoVisible>false</AutoVisible>  
          <StartOn>  
            <Event>documentAfterActivate</Event>
          </StartOn>  
        </Lifecycle>

        <UI>
          <Type>Panel</Type>
          <Menu>Svija Tools</Menu>
          <Geometry>
            <Size>
              <Height>130</Height>
              <Width>240</Width>
            </Size>
            <MaxSize>
              <Height>130</Height>
              <Width>240</Width>
            </MaxSize>
            <MinSize>
              <Height>130</Height>
              <Width>240</Width>
            </MinSize>
          </Geometry>
          <Icons />
        </UI>
      </DispatchInfo>
    </Extension>

    <Extension Id="love.svija.SvijaLauncher.panel"><!-- ———————————————————— -->
      <DispatchInfo>
        <Resources>
          <MainPath>./client/launcher.html</MainPath>
          <CEFCommandLine />
        </Resources>

        <Lifecycle>
          <AutoVisible>false</AutoVisible>  
          <StartOn>  
            <Event>documentAfterActivate</Event>
          </StartOn>  
        </Lifecycle>

        <UI>
          <Type>Panel</Type>
          <Menu>Svija Launcher Utility</Menu>
          <Geometry>
            <Size>
              <Height>130</Height>
              <Width>240</Width>
            </Size>
            <MaxSize>
              <Height>130</Height>
              <Width>240</Width>
            </MaxSize>
            <MinSize>
              <Height>130</Height>
              <Width>240</Width>
            </MinSize>
          </Geometry>
          <Icons />
        </UI>
      </DispatchInfo>
    </Extension>

  </DispatchInfoList>
</ExtensionManifest>
