<?xml version='1.0' encoding='UTF-8'?>
<ExtensionManifest ExtensionBundleId="com.svija.SvijaToolsBeta" ExtensionBundleVersion="1.0.7" Version="11.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <ExtensionList>
    <Extension Id="com.svija.SvijaToolsBeta.panel" Version="1.0.7" />
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <Host Name="ILST" Version="17" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    
    <Extension Id="com.svija.SvijaToolsBeta.panel"><!-- ———————————————————— -->
      <DispatchInfo>
        <Resources>


          <MainPath>./shell.html</MainPath>
          <CEFCommandLine>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>

        </Resources>

        <Lifecycle>
          <AutoVisible>true</AutoVisible>  
          <StartOn>  
            <Event>documentAfterActivate</Event>
          </StartOn>  
        </Lifecycle>

        <UI>
          <Type>Panel</Type>
          <Menu>Svija Tools</Menu>
          <Geometry>
            <Size>
                <Width>240</Width>
                <Height>0</Height>
            </Size>
            <MinSize>
                <Width>60</Width>
                <Height>0</Height>
            </MinSize>
            <MaxSize>
                <Width>240</Width>
                <Height>671</Height>
            </MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./svg/panelicon_light.svg</Icon>
            <Icon Type="DarkNormal">./svg/panelicon_dark.svg</Icon>
            <Icon Type="RollOver">./svg/panelicon_light.svg</Icon>
            <Icon Type="DarkRollover">./svg/panelicon_dark.svg</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>

  </DispatchInfoList>
</ExtensionManifest>
